
@model Tra_Luoi.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/products.css")" />
}

<main>
    @if (Model != null)
    {
        <div class="product-container">
            <div class="product-image">
                <img src="@Url.Content("~/" + Model.ProductImage)"
                     alt="@Model.ProductName">
            </div>

            <div class="product-info">
                <h1 id="product-name">@Model.ProductName</h1>

                <h2 id="product-price">
                    @string.Format("{0:N0} VNĐ", Model.ProductPrice)
                </h2>

                <p class="description">@Model.Description</p>

                <h3>Kích cỡ</h3>
                <div class="size">
                    <button type="button">S</button>
                    <button type="button" class="active">M</button>
                    <button type="button">L</button>
                </div>

                <h3>Số lượng</h3>
                <input type="number" value="1" min="1">

                <br><br>

                <button type="button" class="buy-btn btn-add">
                    Thêm vào giỏ hàng
                </button>

                <button type="button" class="order-btn">
                    Mua ngay
                </button>
            </div>
        </div>

        <div class="detail">
            <h2>Thông tin sản phẩm</h2>
            <p style="white-space: pre-line;">@Model.Description</p>
        </div>
    }
    else
    {
        <p style="padding: 20px; color: red;">
            Không tìm thấy sản phẩm.
        </p>
    }
</main>
