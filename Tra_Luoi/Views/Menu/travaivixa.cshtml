
@{
    ViewBag.Title = "travaivixa";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/products.css")" />
}
<main>
    <main>

        <div class="product-container">

            <div class="product-image">
                <img src="../img/z7955591111676_690589f68231a9caa43b94991e1ccf83.jpg" alt="fig tree">
            </div>

            <div class="product-info">

                <h1>Lemongrass Lychee Tea</h1>

                <h2>35.000 VNĐ</h2>

                <p class="description">
                    Trà Vải Vị Sả là sự kết hợp giữa trà thơm, trái vải ngọt thanh và hương sả tự nhiên.
                    Mang đến cảm giác thư giãn và sảng khoái.
                </p>

                <h3>Kích cỡ</h3>

                <div class="size">
                    <button>S</button>
                    <button class="active">M</button>
                    <button>L</button>
                </div>

                <h3>Số lượng</h3>

                <input type="number" value="1" min="1">

                <br><br>

                <button class="buy-btn">Thêm vào giỏ hàng</button>

                <button class="order-btn">Mua ngay</button>

            </div>
        </div>
        <div class="detail">



            <h2>Thông tin sản phẩm</h2>

            <p>
                Được pha từ trà đen kết hợp cùng vải tươi và sả.
            </p>

            <p>
                Thức uống có vị ngọt dịu, hương thơm dễ chịu và rất thích hợp dùng lạnh.
            </p>

        </div>

    </main>

</main>

