
@{
    ViewBag.Title = "Caphe";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/products.css")" />
    }

    <main>

        <div class="product-container">
        
            <div class="product-image">
                <img src="../img/z7955591107600_7db1d394557e9abb8bb1b7536a735274.jpg" alt="Cappuccino">
            </div>
        
            <div class="product-info">
        
                <h1 id="product-name">Cappuccino</h1>
        
                <h2 id="product-price">30.000 VNĐ</h2>
        
                <p class="description">
                    Cappuccino là sự kết hợp hài hòa giữa Espresso đậm vị,
                    sữa tươi nóng và lớp bọt sữa mịn. Hương thơm cà phê quyện
                    cùng vị béo nhẹ tạo nên thức uống phù hợp cho mọi thời điểm
                    trong ngày.
                </p>
        
                <h3>Kích cỡ</h3>
        
                <div class="size">
                    <button>S</button>
                    <button class="active">M</button>
                    <button>L</button>
                </div>
        
                <h3>Số lượng</h3>
        
                <input type="number" value="1" min="1">
        
                <br><br>
        
                <button class="buy-btn btn-add">
                    Thêm vào giỏ hàng
                </button>
        
                <button class="order-btn">
                    Mua ngay
                </button>
        
            </div>
        
        </div>
        
        <div class="detail">
        
        <h2>Thông tin sản phẩm</h2>
        
        <p>
        Cappuccino được pha từ hạt Arabica rang vừa,
        kết hợp với sữa tươi thanh trùng và lớp foam sữa mịn.
        Đồ uống có vị cân bằng giữa vị đắng nhẹ của cà phê
        và vị béo của sữa.
        </p>
        
        <p>
        Thức uống thích hợp dùng nóng hoặc lạnh,
        phù hợp với những khách hàng yêu thích hương vị
        cà phê truyền thống nhưng vẫn muốn cảm giác mềm mại,
        dễ uống.
        </p>
        
        </div>
        
        </main>



