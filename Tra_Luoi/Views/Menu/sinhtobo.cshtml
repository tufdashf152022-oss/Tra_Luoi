
@{
    ViewBag.Title = "sinhtobo";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/products.css")" />
}
<main>
    <main>

        <div class="product-container">

            <div class="product-image">
                <img src="../img/z7955591108794_901504c973c3e116c3baeedaa6c89707.jpg" alt="BƠ VƠ">
            </div>

            <div class="product-info">

                <h1>Avocado Smoothie</h1>

                <h2>35.000 VNĐ</h2>

                <p class="description">
                    Sinh tố Bơ được xay từ bơ chín tự nhiên kết hợp cùng sữa tươi và đá xay.
                    Thức uống có vị béo ngậy, thơm mịn và giàu dinh dưỡng.
                </p>

                <h3>Kích cỡ</h3>

                <div class="size">
                    <button>S</button>
                    <button class="active">M</button>
                    <button>L</button>
                </div>

                <h3>Số lượng</h3>

                <input type="number" value="1" min="1">

                <br><br>

                <button class="buy-btn">Thêm vào giỏ hàng</button>

                <button class="order-btn">Mua ngay</button>

            </div>
        </div>
        <div class="detail">

            <h2>Thông tin sản phẩm</h2>

            <p>
                Được làm từ bơ tươi tuyển chọn, kết hợp cùng sữa đặc và sữa tươi.
            </p>

            <p>
                Đồ uống cung cấp nhiều vitamin và chất béo tốt, thích hợp cho mọi lứa tuổi.
            </p>

        </div>

    </main>

</main>

