
@{
    ViewBag.Title = "trasua";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/products.css")" />
}
<main>
    <main>

        <div class="product-container">

            <div class="product-image">
                <img src="../img/z7955591108642_5a4fbfc46737ec8db2431ead4103a2fc.jpg" alt="Milk Tea">
            </div>

            <div class="product-info">

                <h1>Milk Tea</h1>

                <h2>30.000 VNĐ</h2>

                <p class="description">
                    Trà Sữa được pha từ trà đen thơm đậm kết hợp cùng sữa tươi và trân châu dai mềm.
                    Hương vị ngọt thanh, béo nhẹ, phù hợp với mọi lứa tuổi.
                </p>

                <h3>Kích cỡ</h3>

                <div class="size">
                    <button>S</button>
                    <button class="active">M</button>
                    <button>L</button>
                </div>

                <h3>Số lượng</h3>

                <input type="number" value="1" min="1">

                <br><br>

                <button class="buy-btn">Thêm vào giỏ hàng</button>

                <button class="order-btn">Mua ngay</button>

            </div>
        </div>
        <div class="detail">

            <h2>Thông tin sản phẩm</h2>

            <p>
                Milk Tea được pha từ trà đen nguyên lá kết hợp với sữa tươi và trân châu.
                Đồ uống có vị trà thơm, béo nhẹ và ngọt vừa.
            </p>

            <p>
                Thích hợp dùng lạnh, mang lại cảm giác tươi mát và là thức uống được yêu thích quanh năm.
            </p>

        </div>

    </main>

</main>

