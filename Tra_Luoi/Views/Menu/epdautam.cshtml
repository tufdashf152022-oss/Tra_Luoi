
@{
    ViewBag.Title = "epdautam";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/products.css")" />
}   
<main>
    <main>

        <div class="product-container">

            <div class="product-image">
                <img src="../img/z7955591112699_ca0ee584387e882be2383e1be277ff43.jpg" alt="mulberry">
            </div>

            <div class="product-info">

                <h1>Mulberry Juice</h1>

                <h2>30.000 VNĐ</h2>

                <p class="description">
                    Nước ép Dâu Tằm có vị chua ngọt tự nhiên, màu sắc đẹp mắt và giàu chất chống oxy hóa.
                    Là lựa chọn lý tưởng để giải khát mỗi ngày.
                </p>

                <h3>Kích cỡ</h3>

                <div class="size">
                    <button>S</button>
                    <button class="active">M</button>
                    <button>L</button>
                </div>

                <h3>Số lượng</h3>

                <input type="number" value="1" min="1">

                <br><br>

                <button class="buy-btn">Thêm vào giỏ hàng</button>

                <button class="order-btn">Mua ngay</button>

            </div>
        </div>
        <div class="detail">

            <h2>Thông tin sản phẩm</h2>

            <p>
                Được chế biến từ dâu tằm tươi tuyển chọn, giữ nguyên hương vị tự nhiên.
            </p>

            <p>
                Giàu vitamin và chất chống oxy hóa, giúp cơ thể luôn tươi mát và khỏe mạnh.
            </p>

        </div>

    </main>

</main>

