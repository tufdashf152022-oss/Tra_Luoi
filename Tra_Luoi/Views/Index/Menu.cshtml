
@model IEnumerable<Tra_Luoi.Models.Product>

@{
    ViewBag.Title = "Menu";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/nuocluoi.css")">
}

<main>
    <section class="menu">
        <div class="menu-grid">

            @foreach (var item in Model)
            {
                <div class="item">
                    <a href="@Url.Action("DetailsProducts", "Menu", new { id = item.ProductID })">
                        <img src="@Url.Content("~/" + item.ProductImage)"
                             alt="@item.ProductName">
                    </a>

                    <h3>@item.ProductName</h3>

                    <p>@item.ProductName</p>

                    <div class="price">
                        @item.ProductPrice.ToString("N0")đ
                    </div>
                </div>
            }

        </div>
    </section>
</main>
