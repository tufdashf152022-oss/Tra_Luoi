
@{
    ViewBag.Title = "FAQ";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/faq.css")" />
}
<h2>FAQ</h2>

<main class="faq-page">


    <!-- BANNER -->
    <!-- FAQ -->

    <section class="faq-container">


        <!-- TIÊU ĐỀ -->

        <div class="faq-title">

            <h1>CÂU HỎI THƯỜNG GẶP</h1>

            <p>
                Giải đáp những thắc mắc thường gặp khi sử dụng
                sản phẩm và dịch vụ của Trà Lười.
            </p>

        </div>


        <!-- TÌM KIẾM -->

        <div class="faq-search">

            <input type="text"
                   id="searchFAQ"
                   placeholder="Bạn cần tìm thông tin gì?">

            <button type="button">
                <i class="bi bi-search"></i>
                TÌM KIẾM
            </button>

        </div>


        <!-- ================= SẢN PHẨM ================= -->

        <div class="faq-category">

            <h2>SẢN PHẨM</h2>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Trà Lười có những loại thức uống nào?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Trà Lười cung cấp nhiều loại thức uống như
                        trà sữa, trà trái cây và các loại nước uống
                        đặc trưng của thương hiệu.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Tôi có thể thay đổi lượng đường và đá không?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Có. Khách hàng có thể lựa chọn mức đường và
                        lượng đá phù hợp với sở thích khi đặt thức uống.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Trà Lười có những loại topping nào?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Tùy từng loại thức uống, khách hàng có thể
                        lựa chọn thêm các loại topping được cung cấp
                        trong thực đơn.
                    </p>

                </div>

            </div>

        </div>


        <!-- ================= ĐẶT HÀNG ================= -->

        <div class="faq-category">

            <h2>ĐẶT HÀNG</h2>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Làm thế nào để đặt thức uống?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Khách hàng truy cập mục MENU, lựa chọn thức uống
                        yêu thích và thực hiện các bước đặt hàng.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Tôi có thể hủy đơn hàng sau khi đặt không?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Việc hủy đơn hàng phụ thuộc vào tình trạng xử lý
                        đơn hàng. Vui lòng liên hệ với Trà Lười để được
                        hỗ trợ nhanh chóng.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Trà Lười hỗ trợ những phương thức thanh toán nào?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Khách hàng có thể lựa chọn phương thức thanh toán
                        được cung cấp trong quá trình đặt hàng.
                    </p>

                </div>

            </div>

        </div>


        <!-- ================= CỬA HÀNG ================= -->

        <div class="faq-category">

            <h2>CỬA HÀNG</h2>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Làm thế nào để tìm cửa hàng Trà Lười?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Bạn có thể truy cập mục STORE trên website
                        để xem thông tin và địa điểm các cửa hàng
                        Trà Lười.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Trà Lười mở cửa vào thời gian nào?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Thời gian hoạt động có thể khác nhau tùy từng
                        cửa hàng. Vui lòng kiểm tra thông tin cửa hàng
                        trước khi đến.
                    </p>

                </div>

            </div>

        </div>


        <!-- ================= KHUYẾN MÃI ================= -->

        <div class="faq-category">

            <h2>KHUYẾN MÃI</h2>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Làm thế nào để sử dụng voucher?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Voucher có thể được sử dụng theo điều kiện
                        và thời gian áp dụng được quy định trong
                        từng chương trình khuyến mãi.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">

                    <span>
                        Trà Lười có chương trình thành viên không?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>

                <div class="faq-answer">

                    <p>
                        Trà Lười có thể triển khai các chương trình
                        dành cho khách hàng thành viên và các ưu đãi
                        theo từng thời điểm.
                    </p>

                </div>

            </div>

        </div>


        <!-- ================= LIÊN HỆ ================= -->

        <div class="faq-contact">

            <h2>BẠN VẪN CÒN THẮC MẮC?</h2>

            <p>
                Nếu chưa tìm thấy câu trả lời phù hợp,
                hãy liên hệ với Trà Lười để được hỗ trợ.
            </p>

            <a href="contact.html">
                LIÊN HỆ VỚI CHÚNG TÔI
            </a>

        </div>

    </section>

</main>