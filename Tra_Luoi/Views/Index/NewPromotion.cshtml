
@{
    ViewBag.Title = "NewPromotion";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/newap.css")"} />
    }

<main class="news-page">

    <!-- NEWS / PROMOTIONS -->
    <div class="news-tabs">

        <a href="#" class="tab">
            <i class="bi bi-cup-straw"></i>
            <span>News</span>
        </a>

        <a href="#" class="tab">
            <i class="bi bi-cup-straw"></i>
            <span>Promotions</span>
        </a>

    </div>


    <!-- DANH SÁCH BÀI VIẾT -->
    <section class="news-grid">

        <!-- BÀI 1 -->
        <article class="news-card">

            <div class="news-image">
                <img src="../img/z7955591122776_a62d0510c6368ee2f32266696ef6c322.jpg" alt="Trà Lười - Hương vị mới">
                <span class="news-label">NEWS</span>
            </div>

            <div class="news-content">

                <div class="news-title">
                    <h2>TRÀ LƯỜI RA MẮT HƯƠNG VỊ MỚI</h2>

                    <a href="@Url.Action("Details", "News", new { id = 1 })">
                        CHI TIẾT <span>›</span>
                    </a>
                </div>

                <p>
                    Khám phá những hương vị trà mới được Trà Lười
                    giới thiệu dành cho những ngày thư giãn.
                </p>

            </div>

        </article>


        <!-- BÀI 2 -->
        <article class="news-card">

            <div class="news-image">
                <img src="../img/z7955591126707_011760d26a9173924fa86438906542d7.jpg" alt="Trà trái cây Trà Lười">
                <span class="news-label">NEWS</span>
            </div>

            <div class="news-content">

                <div class="news-title">
                    <h2>TRÀ TRÁI CÂY - TƯƠI MÁT MỖI NGÀY</h2>

                    <a href="@Url.Action("Details", "News", new { id = 2 })">
                        CHI TIẾT <span>›</span>
                    </a>
                </div>

                <p>
                    Sự kết hợp giữa trà thanh mát và trái cây
                    tạo nên thức uống phù hợp cho những ngày hè.
                </p>

            </div>

        </article>


        <!-- BÀI 3 -->
        <article class="news-card">

            <div class="news-image">
                <img src="../img/Gemini_Generated_Image_521q48521q48521q.png"
                     alt="Khuyến mãi Trà Lười">

                <span class="news-label">NEWS</span>
            </div>

            <div class="news-content">

                <div class="news-title">
                    <h2>ƯU ĐÃI ĐẶC BIỆT DÀNH CHO BẠN</h2>

                    <a href="@Url.Action("Details", "News", new { id = 3 })">
                        CHI TIẾT <span>›</span>
                    </a>
                </div>

                <p>
                    Đừng bỏ lỡ những chương trình ưu đãi hấp dẫn
                    dành riêng cho khách hàng của Trà Lười.
                </p>

            </div>

        </article>


        <!-- BÀI 4 -->
        <article class="news-card">

            <div class="news-image">
                <img src="../img/z7955591122394_66912c1fd6e7f7a8187070b7aa72dbe0.jpg"
                     alt="Trà sữa Trà Lười">

                <span class="news-label">NEWS</span>
            </div>

            <div class="news-content">

                <div class="news-title">
                    <h2>TRÀ SỮA TRÀ LƯỜI - VỊ NGON KHÓ CƯỠNG</h2>

                    <a href="@Url.Action("Details", "News", new { id = 4 })">
                        CHI TIẾT <span>›</span>
                    </a>
                </div>

                <p>
                    Những ly trà sữa thơm ngon với nhiều lựa chọn
                    topping dành cho tín đồ yêu trà sữa.
                </p>

            </div>

        </article>


        <!-- BÀI 5 -->
        <article class="news-card">

            <div class="news-image">
                <img src="../img/z7955591130217_4bba29551173b25a61e5cfb01086b19b.jpg" alt="Ưu đãi Trà Lười">
                <span class="news-label">NEWS</span>
            </div>

            <div class="news-content">

                <div class="news-title">
                    <h2>TRÀ LƯỜI - ƯU ĐÃI MỖI NGÀY</h2>

                    <a href="@Url.Action("Details", "News", new { id = 5 })">
                        CHI TIẾT <span>›</span>
                    </a>
                </div>

                <p>
                    Cùng Trà Lười tận hưởng những chương trình
                    khuyến mãi hấp dẫn trong tháng.
                </p>

            </div>

        </article>


        <!-- BÀI 6 -->
        <article class="news-card">

            <div class="news-image">
                <img src="../img/z7955591126655_dec5e1f78c4baf7ce70fbefacd00102e.jpg" alt="Sản phẩm mới Trà Lười">
                <span class="news-label">NEWS</span>
            </div>

            <div class="news-content">

                <div class="news-title">
                    <h2>KHÁM PHÁ MENU MỚI CỦA TRÀ LƯỜI</h2>

                    <a href="@Url.Action("Details", "News", new { id = 6 })">
                        CHI TIẾT <span>›</span>
                    </a>
                </div>

                <p>
                    Cập nhật những thức uống mới và lựa chọn
                    yêu thích của bạn tại Trà Lười.
                </p>

            </div>

        </article>

    </section>

</main>

