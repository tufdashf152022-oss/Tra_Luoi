
@{
    ViewBag.Title = "News";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/new1.css")" } />
}

<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a href="#">Trang chủ</a> /
    <a href="#">Tin tức</a> /
    Chi tiết tin tức
</div>

<!-- MAIN CONTENT -->
<main class="container">

    <!-- CỘT 4: SIDEBAR -->
    <aside class="sidebar">

        <img src="~/img/z7955591122776_a62d0510c6368ee2f32266696ef6c322.jpg"
             alt="Trà Lưới hương vị mới">

        <h3>Trà Lười ra mắt hương vị mới</h3>

        <p>
            Khám phá những hương vị trà mới được
            Trà Lười giới thiệu dành cho những
            ngày thư giãn.
        </p>

        <span class="category">TIN TỨC</span>

        <div class="info">
            <p><b>Danh mục:</b> Tin tức</p>
            <p><b>Ngày đăng:</b> 06/11/2026</p>
            <p><b>Thương hiệu:</b> Trà Lười</p>
        </div>

    </aside>

    <!-- CỘT 8: ARTICLE -->
    <article class="article">

        <div class="date">
            TIN TỨC | 06/11/2026
        </div>

        <h1>TRÀ LƯỜI RA MẮT HƯƠNG VỊ MỚI</h1>

        <p class="intro">
            Khám phá những hương vị trà mới được
            Trà Lười giới thiệu dành cho những
            ngày thư giãn. Sự kết hợp giữa trà
            thanh mát và trái cây tươi mang đến
            trải nghiệm thưởng thức đầy mới mẻ.
        </p>

        <h2>1. Giới thiệu sản phẩm mới</h2>

        <p>
            Với mong muốn mang đến những trải nghiệm
            mới cho khách hàng, Trà Lười chính thức
            giới thiệu dòng thức uống mới được kết
            hợp từ trà thơm ngon và các loại trái cây
            tươi tự nhiên.
        </p>

        <p>
            Sản phẩm được chăm chút từ hương vị đến
            hình thức, tạo nên sự hài hòa giữa vị trà
            thanh nhẹ, vị chua ngọt của trái cây và
            cảm giác tươi mát khi thưởng thức.
        </p>

        <h2>2. Điểm nổi bật của hương vị mới</h2>

        <p>
            Điểm đặc biệt của dòng sản phẩm lần này
            nằm ở sự kết hợp nguyên liệu tươi ngon,
            hương vị cân bằng và cách trình bày bắt mắt.
            Đây sẽ là lựa chọn phù hợp cho những ngày
            hè hoặc những lúc bạn muốn tìm kiếm một
            thức uống giải khát.
        </p>

        <h2>3. Trải nghiệm ngay hôm nay</h2>

        <p>
            Trà Lười hy vọng những hương vị mới sẽ
            mang đến cho khách hàng những phút giây
            thư giãn và những trải nghiệm đáng nhớ.
            Hãy ghé cửa hàng để khám phá và thưởng
            thức sản phẩm mới ngay hôm nay!
        </p>

        <a href="#" class="back">
            ← Quay lại trang
        </a>

    </article>

</main>