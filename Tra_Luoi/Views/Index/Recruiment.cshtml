
@model IEnumerable<Tra_Luoi.Models.Job_Stores>

@{
    ViewBag.Title = "Tuyển dụng";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/recruitment.css")" />
}

<main class="recruitment-page">
    <section class="recruitment-container">

        <!-- DANH SÁCH CÔNG VIỆC -->
        <section class="jobs-grid" id="jobsGrid">

            @foreach (var item in Model)
            {
                <article class="job-card"
                         data-category="@item.Category">

                    <h2>@item.Title</h2>

                    <div class="job-info">

                        <span>
                            <i class="bi bi-calendar"></i>
                            @(item.Created_At.HasValue
                                ? item.Created_At.Value.ToString("dd/MM/yyyy")
                                : "Chưa cập nhật")
                        </span>

                        <span class="dot">•</span>

                        <span>@item.Employment_Type</span>

                    </div>

                    <div class="job-bottom">

                        <p>
                            Hạn nộp:
                            <strong>
                                @(item.Application_Deadline.HasValue
                                    ? item.Application_Deadline.Value.ToString("dd/MM/yyyy")
                                    : "Chưa cập nhật")
                            </strong>
                        </p>

                        @Html.ActionLink(
                         "Ứng Tuyển",
                         "Employees",
                         "Employees",
                         new { id = item.Job_Store_ID },
                         new { @class = "apply-btn" }
)
                        

                    </div>

                </article>
            }

        </section>

    </section>
</main>
