
@{
    ViewBag.Title = "Recruiment";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/recruitment.css")" />
    }
<main class="recruitment-page">

    <section class="recruitment-container">

        <!-- KHU VỰC TUYỂN DỤNG -->

        <div class="filter-top">

            <select id="locationFilter">

                <option value="all">
                    Khu Vực Tuyển Dụng
                </option>

                <option value="ho-chi-minh">
                    Hồ Chí Minh
                </option>

                <option value="ha-noi">
                    Hà Nội
                </option>

                <option value="ha-nam">
                    Hà Nam
                </option>

                <option value="thanh-hoa">
                    Thanh Hóa
                </option>

                <option value="nam-dinh">
                    Nam Định
                </option>

                <option value="hai-duong">
                    Hải Dương
                </option>

                <option value="long-an">
                    Long An
                </option>

            </select>

        </div>


        <!-- BỘ LỌC -->

        <div class="filter-row">

            <button class="filter-btn active"
                    data-category="all">
                Tất Cả Việc Làm
            </button>

            <button class="filter-btn"
                    data-category="store">
                Việc Làm Khối Cửa Hàng
            </button>

            <button class="filter-btn"
                    data-category="supply">
                Việc Làm Khối Chuỗi Cung Ứng
            </button>

            <button class="filter-btn"
                    data-category="office">
                Việc Làm Khối Văn Phòng
            </button>

            <div class="search-box">

                <input type="text"
                       id="searchInput"
                       placeholder="Tìm Kiếm Công Việc">

                <i class="bi bi-search"></i>

            </div>

        </div>


        <!-- SỐ LƯỢNG -->

        <div class="job-count">
            Số lượng:
            <span id="jobCount">12</span>
        </div>


        <!-- DANH SÁCH CÔNG VIỆC -->

