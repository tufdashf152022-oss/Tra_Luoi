
@model Tra_Luoi.Models.Job_Stores

@{
    ViewBag.Title = "Chi tiết tuyển dụng";
    Layout = "~/Views/Shared/Tra_Luoi.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/ctrecruiment.css")" />
}

<main class="container">

    <div class="breadcrumb">
        <a href="#">Trang chủ</a> /
        <a href="@Url.Action("Recruitment", "Employees")">Tuyển Dụng</a> /
        Chi Tiết Tuyển Dụng
    </div>

    @if (Model != null && Model.Job != null)
    {
        <section class="job-detail">

            <div class="job-detail-header">
                <h2>@Model.Job.Title</h2>

                <p>
                    <strong>Vị trí:</strong>
                    @Model.Job.Title
                </p>

                <p>
                    <strong>Danh mục:</strong>
                    @Model.Job.Category
                </p>

                <p>
                    <strong>Hình thức làm việc:</strong>
                    @Model.Job.Employment_Type
                </p>

                <p>
                    <strong>Số lượng tuyển:</strong>
                    @Model.Headcount
                </p>

                <p>
                    <strong>Hạn nộp hồ sơ:</strong>
                    @(Model.Application_Deadline.HasValue
                        ? Model.Application_Deadline.Value.ToString("dd/MM/yyyy")
                        : "Chưa cập nhật")
                </p>
            </div>

            <div class="job-detail-content">

                <h3>1. Mô tả công việc</h3>
                <p style="white-space: pre-line;">@Model.Job.Description</p>

                <h3>2. Yêu cầu ứng viên</h3>
                <p style="white-space: pre-line;">@Model.Job.Requirements</p>

                <h3>3. Quyền lợi được hưởng</h3>
                <p style="white-space: pre-line;">@Model.Job.Benefits</p>

            </div>

            <div class="job-detail-footer">
                <p>
                    <strong>Bạn quan tâm đến vị trí tuyển dụng này?</strong><br />
                    Hãy gia nhập Trà Lười để cùng phát triển và xây dựng môi trường làm việc chuyên nghiệp!
                </p>

                <a href="#" class="job-apply-button">
                    Ứng tuyển ngay
                </a>
            </div>

        </section>
    }
    else
    {
        <p>Không tìm thấy thông tin tuyển dụng.</p>
    }

</main>
